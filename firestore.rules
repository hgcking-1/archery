rules_version = '2';
// 양궁 점수 사이트 보안 규칙 (2단계)
// - 선생님: 아래 이메일의 구글 계정만 모든 자료를 보고 고칠 수 있음
//   (공개 저장소라서 자리표시자를 넣어 두었어요. 배포 전에 실제 선생님 이메일로 바꾸고, index.html의 TEACHERS와 같게 맞추세요)
// - 학생: 학번 + 비밀번호(4자리)가 맞아야 '연결'되고, 자기 반 자료만 볼 수 있음
service cloud.firestore {
  match /databases/{database}/documents {

    function isTeacher() {
      return request.auth != null
        && request.auth.token.email in ['teacher1@example.com', 'teacher2@example.com']
        && request.auth.token.email_verified == true;
    }
    function linkPath() {
      return /databases/$(database)/documents/links/$(request.auth.uid);
    }
    function isLinked() {
      return request.auth != null && exists(linkPath());
    }
    function me() {
      return get(linkPath()).data;
    }

    // 학생 명단: 선생님은 전부, 학생은 자기 반 친구만 볼 수 있음
    match /students/{sid} {
      allow read: if isTeacher() || (isLinked() && me().cls == resource.data.cls);
      allow write: if isTeacher();
    }

    // 비밀번호: 선생님만
    match /secrets/{sid} {
      allow read, write: if isTeacher();
    }

    // 로그인 연결: 학번과 비밀번호가 맞을 때만 만들 수 있음
    match /links/{uid} {
      allow read: if isTeacher() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['sid', 'cls', 'pin', 'at'])
        && request.resource.data.pin is string
        && get(/databases/$(database)/documents/secrets/$(request.resource.data.sid)).data.pin == request.resource.data.pin
        && get(/databases/$(database)/documents/students/$(request.resource.data.sid)).data.cls == request.resource.data.cls;
      allow delete: if isTeacher() || (request.auth != null && request.auth.uid == uid);
      allow update: if false;
    }
    // 하루 기록(이름 있음): 선생님은 전부, 학생은 우리 반 것만 보고 자기 것만 씀
    match /sessions/{rid} {
      // 아직 없는 '오늘 기록'도 내 것이면 열어 볼 수 있어야 해서 문서 이름(학번_날짜)으로도 확인
      allow read: if isTeacher() || (isLinked() && (rid.matches(me().sid + '_.*') || me().cls == resource.data.cls));
      allow delete: if isTeacher();
      allow create, update: if isTeacher() || (isLinked()
        && rid == me().sid + '_' + request.resource.data.date
        && request.resource.data.sid == me().sid
        && request.resource.data.cls == me().cls
        && request.resource.data.arrows is list
        && request.resource.data.arrows.size() <= 30
        && request.resource.data.count == request.resource.data.arrows.size()
        && request.resource.data.total <= request.resource.data.count * 10);
    }

    // 하루 기록(이름 없음): 다른 반 평균과 전체 순위(반만 표시)에 씀. 로그인한 사람은 누구나 볼 수 있음
    match /pub/{pid} {
      allow read: if isTeacher() || isLinked();
      allow delete: if isTeacher();
      allow create, update: if isTeacher() || (isLinked()
        && pid == request.resource.data.date + '_' + get(/databases/$(database)/documents/students/$(me().sid)).data.anon
        && request.resource.data.keys().hasOnly(['cls', 'date', 'count', 'total', 'xs', 'avg'])
        && request.resource.data.cls == me().cls
        && request.resource.data.count <= 30
        && request.resource.data.total <= request.resource.data.count * 10);
    }
  }
}
